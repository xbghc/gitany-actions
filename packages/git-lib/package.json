{
  "name": "@xbghc/git-lib",
  "version": "0.0.1",
  "description": "Minimal cross-platform git command wrappers with TypeScript support.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build && pnpm typecheck"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "git",
    "wrapper",
    "command",
    "cross-platform",
    "typescript",
    "utilities"
  ],
  "author": "xbghc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xbghc/gitany-actions.git",
    "directory": "packages/git-lib"
  },
  "bugs": {
    "url": "https://github.com/xbghc/gitany-actions/issues"
  },
  "homepage": "https://github.com/xbghc/gitany-actions#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "cross-spawn": "^7.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "@types/cross-spawn": "^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
