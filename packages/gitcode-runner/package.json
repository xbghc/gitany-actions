{
  "name": "@xbghc/gitcode-runner",
  "version": "0.0.1",
  "description": "GitCode Runner - Self-hosted runner for GitCode Actions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gitcode-runner": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint ."
  },
  "dependencies": {
    "@xbghc/gitcode-actions": "workspace:*",
    "@xbghc/gitcode-api": "workspace:*",
    "commander": "^13.0.0",
    "dockerode": "^4.0.8",
    "got": "^14.4.9",
    "superjson": "^2.2.5",
    "tar": "^7.4.3",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.43",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
