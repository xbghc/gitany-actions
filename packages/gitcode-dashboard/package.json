{
  "name": "@xbghc/gitcode-dashboard",
  "version": "0.1.0",
  "description": "Vue 3 dashboard for GitCode repository management",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "pinia": "^2.3.0",
    "element-plus": "^2.9.2",
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "@vueuse/core": "^13.9.0",
    "marked": "^15.0.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0",
    "typescript": "^5.9.2",
    "@types/node": "^22.10.2",
    "@types/marked": "^6.0.0",
    "unplugin-vue-components": "^0.27.4",
    "unplugin-auto-import": "^0.18.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
