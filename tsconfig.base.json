{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declarationMap": true,
    "inlineSources": true,
    "composite": true
  },
  "references": [
    { "path": "./packages/gitcode-api" },
    { "path": "./packages/git-lib" },
    { "path": "./packages/gitcode-actions" },
    { "path": "./packages/gitcode-cli" },
    { "path": "./packages/server" }
  ]
}
