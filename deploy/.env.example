# GitCode Actions 部署环境变量配置

# ==================== Server 配置 ====================

# 运行环境：development | production
NODE_ENV=production

# 服务端口
PORT=3000

# Docker 节点配置
# - local: 使用本机 Docker（通过 unix socket）
# - name:host:port: 远程 Docker 节点
# - 多节点用逗号分隔：local,remote1:192.168.1.100:2375,remote2:192.168.1.101:2375
DOCKER_NODES=local

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# ==================== OAuth 配置（可选）====================

# GitCode OAuth 应用配置（用于用户登录）
# GITCODE_OAUTH_CLIENT_ID=your_client_id
# GITCODE_OAUTH_CLIENT_SECRET=your_client_secret
# GITCODE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback
